[Unit]
Description=X data collect ingest API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/xcollect
EnvironmentFile=/opt/xcollect/config.env
Environment=HOME=/root
Environment=TZ=Asia/Shanghai
Environment=PATH=/opt/node24/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/xcollect/ingest_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
