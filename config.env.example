# X 发布板配置 —— 复制为 config.env 后填你自己的值。
# board 与 collect 两个服务共用这一份（部署时分别放到 /opt/xboard/config.env 与 /opt/xcollect/config.env，或用 systemd 的 EnvironmentFile 指向同一份）。
# 本文件不要提交到任何仓库（已在 .gitignore 里）。

# --- 飞书（必填）---
# Base 链接形如 https://my.feishu.cn/base/<这一段就是 BASE_TOKEN>
FEISHU_BASE_TOKEN=
# 四张表的 table_id（在 Base 里打开表，lark-cli base +table-list 可查）
FEISHU_PUBLISH_TABLE_ID=
FEISHU_TOPIC_TABLE_ID=
FEISHU_DAILY_TABLE_ID=
FEISHU_BENCHMARK_TABLE_ID=
# lark-cli 路径（which lark-cli 查）
LARK_CLI=/opt/node24/bin/lark-cli

# --- 你的 X 账号（必填）---
# 主账号 handle，不带 @。回采只认这个账号，不是它直接跳过。
X_TARGET_ACCOUNT=your_handle
# 发布板预览里显示的昵称映射（JSON，键带 @）。多个发布账号都填这里。
X_DISPLAY_NAMES_JSON={"@your_handle": "Your Name"}

# --- 站点（必填）---
# 你的域名与板页地址（扩展打包、FxTwitter User-Agent 用）
SITE_DOMAIN=example.com
SITE_URL=https://example.com/x/

# --- 路径（一般不用改）---
XBOARD_OUT_DIR=/var/www/x-publish-board/x
XBOARD_TOKEN_FILE=/opt/xboard/state-token.txt
XCOLLECT_STATE_DIR=/opt/xcollect
XCOLLECT_TOKEN_FILE=/opt/xcollect/collect-token.txt
XCOLLECT_EXTENSION_DIR=/opt/xcollect/extension
EXTENSION_ZIP_OUT=/var/www/x-publish-board/xcollect/extension.zip
